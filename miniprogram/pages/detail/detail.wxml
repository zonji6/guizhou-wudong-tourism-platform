<view wx:if="{{item}}"><image wx:if="{{item.image && !imageFailed}}" class="cover" src="{{item.image}}" mode="aspectFill" aria-label="{{item.imageAlt}}" binderror="imageError"/><view wx:else role="img" aria-label="{{item.imageAlt}}" class="cover image-fallback">{{item.imageAlt}}</view><view class="page"><view class="eyebrow">贵州乌东 · 演示资源</view><view class="title">{{item.title}}</view><text class="tag" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text><view class="intro">{{item.intro}}</view><view class="price">¥{{item.price}} <text>起 / 演示价格</text></view><view class="primary" bindtap="booking">预约这项体验</view></view></view><view wx:else class="page"><view class="title">未找到可浏览服务</view></view>
