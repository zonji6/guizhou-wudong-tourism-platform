.suggestions { margin:28rpx 0 18rpx; }.suggestions text, .chips text { display:inline-block; padding:10rpx 15rpx; margin:0 10rpx 10rpx 0; color:#315f4b; border:1rpx solid #ddd8cc; border-radius:30rpx; font-size:23rpx; }.ask { width:100%; height:190rpx; box-sizing:border-box; padding:18rpx; background:#fff; border:1rpx solid #ddd8cc; }.progress { color:#315f4b; padding:21rpx 0; }.agent-card { padding:25rpx; background:#fffdf8; border-left:6rpx solid #b56f3b; box-shadow:0 7rpx 18rpx rgba(35,58,46,.06); }.card-type { color:#b56f3b; font-size:20rpx; letter-spacing:2rpx; text-transform:uppercase; }.card-title { margin:10rpx 0; font-size:32rpx; font-weight:700; }.steps { margin-top:18rpx; color:#43544b; line-height:1.8; }.sources { margin-top:20rpx; padding-top:15rpx; border-top:1rpx solid #ece6d9; color:#718077; font-size:21rpx; }.sources text { margin-left:8rpx; color:#315f4b; }.book-link { margin-top:25rpx; color:#315f4b; font-weight:600; }
