.guide-card,.workspace,.result{margin-top:28rpx;padding:28rpx;background:#fffdf8;border:1rpx solid rgba(49,95,75,.14);border-radius:26rpx}.guide-card{display:grid;grid-template-columns:96rpx 1fr;gap:22rpx}.leaf{display:grid;width:96rpx;height:96rpx;place-items:center;color:#fff;background:#315f4b;border-radius:70% 30% 65% 35%;font-size:38rpx;transform:rotate(-8deg)}.card-title{color:#173f36;font-size:30rpx;font-weight:700;margin-bottom:10rpx}.guide-card button{grid-column:1/-1}.workspace{display:grid;gap:22rpx;background:linear-gradient(145deg,#fffdf8,#eef5ed)}.workspace-head{display:flex;justify-content:space-between;gap:18rpx;align-items:start}.workspace-head text{padding:10rpx 16rpx;color:#397f7a;background:#dfeee2;border-radius:99rpx;font-size:22rpx;white-space:nowrap}.dialogue{display:grid;gap:12rpx}.message{display:grid;grid-template-columns:120rpx 1fr;gap:14rpx;padding:16rpx;border-radius:16rpx;background:#fff}.message.user{background:#e2efe6}.message text{color:#c6734d;font-weight:700}.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.quick button{padding:18rpx 8rpx;color:#315f4b;background:#edf1e7;font-size:22rpx}.workspace textarea{min-height:180rpx;box-sizing:border-box;width:100%;padding:18rpx;border:1rpx solid #d8d8cc;border-radius:16rpx;background:#fff;font-size:27rpx}.phases{display:flex;flex-wrap:wrap;gap:10rpx}.phases text{padding:8rpx 13rpx;color:#718077;background:#f4f2e8;border-radius:99rpx;font-size:20rpx;transition:all .24s ease}.phases text.active{color:#fff;background:#397f7a;box-shadow:0 8rpx 16rpx rgba(49,95,75,.18);transform:translateY(-2rpx)}.result{margin-top:0}.day{margin-top:18rpx;padding:18rpx;border-left:6rpx solid #a9c8ad;background:#f5faf4;font-weight:700}.stop{display:flex;gap:14rpx;margin-top:16rpx;font-weight:400}.stop>text{display:grid;flex:0 0 34rpx;width:34rpx;height:34rpx;place-items:center;color:#fff;background:#397f7a;border-radius:50%;font-size:20rpx}.stop small,.recommend small{display:block;margin-top:4rpx;color:#65776f;font-size:22rpx;line-height:1.6}.notice,.references{margin-top:18rpx;color:#795236;font-size:22rpx;line-height:1.65}.answer{margin-top:18rpx;color:#40564c;line-height:1.85;white-space:pre-wrap}.recommend{margin-top:14rpx;padding:16rpx;background:#f5faf4;border-radius:14rpx}.recommend-price{margin-top:12rpx;color:#b55e3e;font-size:26rpx;font-weight:700}.recommend-price text{margin-left:8rpx;color:#718077;font-size:19rpx;font-weight:400}.recommend-tags{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:12rpx}.recommend-tags text{padding:5rpx 11rpx;color:#315f4b;background:#e3efe5;border-radius:999rpx;font-size:19rpx}.recommend-note{margin-top:10rpx;color:#8a654d;font-size:20rpx}.save-trip{margin-top:22rpx}.bottom{margin-top:22rpx}
