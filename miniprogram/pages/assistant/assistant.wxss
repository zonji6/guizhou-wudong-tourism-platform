.guide-card{display:grid;grid-template-columns:100rpx 1fr;gap:22rpx;margin-top:28rpx;padding:28rpx;background:#fffdf8;border:1rpx solid rgba(49,95,75,.13);border-radius:24rpx}.leaf{display:grid;width:96rpx;height:96rpx;place-items:center;color:#fff;background:#315f4b;border-radius:70% 30% 65% 35%;font-size:38rpx;transform:rotate(-8deg)}.card-title{color:#173f36;font-size:30rpx;font-weight:700;margin-bottom:10rpx}.guide-card button{grid-column:1/-1}.quick{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx;margin-top:20rpx}.quick button{padding:18rpx 8rpx;color:#315f4b;background:#edf1e7;font-size:22rpx}
