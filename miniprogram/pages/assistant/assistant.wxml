<view class="page"><view class="eyebrow">乌东向导</view><view class="title">把你的心愿交给山茶</view><view class="muted">只展示任务进度与结构化结果，不展示提示词或思维链。</view><view class="suggestions"><text data-text="周末两位，安排两天一夜的苗族文化茶旅" bindtap="quick">两天一夜茶旅</text><text data-text="推荐适合亲子的苗绣体验" bindtap="quick">亲子苗绣</text></view><textarea class="ask" value="{{input}}" bindinput="change" placeholder="例如：我想体验贵州乌东的苗族文化和茶旅"/><view class="primary" bindtap="ask">请 AI 规划</view><view wx:if="{{stage}}" class="progress">● {{stage}}</view><view wx:if="{{card}}" class="agent-card"><view class="card-type">{{card.type}}</view><view class="card-title">{{card.title}}</view><view>{{card.text}}</view><view wx:if="{{card.items}}" class="steps"><view wx:for="{{card.items}}" wx:key="*this">{{item}}</view></view><view wx:if="{{card.chips}}" class="chips"><text wx:for="{{card.chips}}" wx:key="*this" data-text="{{item}}" bindtap="quick">{{item}}</text></view><view wx:if="{{card.sources}}" class="sources">资料来源：<text wx:for="{{card.sources}}" wx:key="*this">{{item}}</text></view><view wx:if="{{card.type === 'itinerary'}}" class="book-link" bindtap="toBooking">预约茶园体验 →</view></view></view>
