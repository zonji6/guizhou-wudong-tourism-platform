<view class="page"><view class="eyebrow">乌东向导</view><view class="title">把你的心愿交给山茶</view><view class="suggestions"><text data-text="周末两位，安排两天一夜的苗族文化茶旅" bindtap="quick">两天一夜茶旅</text><text data-text="推荐适合亲子的苗绣体验" bindtap="quick">亲子苗绣</text></view><textarea class="ask" value="{{input}}" bindinput="change" placeholder="例如：我想体验贵州乌东的苗族文化和茶旅"/><view class="primary" bindtap="ask">为我安排乌东之行</view><view class="phases" wx:if="{{isBusy}}"><text wx:for="{{phases}}" wx:key="key">{{item.label}} {{item.state==='active'?'进行中':item.state==='done'?'已完成':'跳过'}}</text></view><view wx:if="{{currentCard}}" class="agent-card"><text wx:if="{{mode==='demo'}}" class="demo">演示模式</text><view class="card-title">{{currentCard.title}}</view><view>{{currentCard.summary}}</view><text wx:if="{{currentCard.data.retrievalMode==='keyword_demo'}}" class="demo">关键词资料（演示）</text><view wx:for="{{currentCard.data.days}}" wx:key="index" class="day"><view>{{item.title || ('第'+(index+1)+'天')}}</view><view wx:for="{{item.items}}" wx:for-item="entry" wx:key="index"><text>{{entry.title}}</text><text wx:if="{{entry.demoData}}" class="demo">演示数据</text><view wx:if="{{entry.serviceId}}"><text data-service-id="{{entry.serviceId}}" bindtap="openService">查看详情</text><text data-service-id="{{entry.serviceId}}" bindtap="bookService">预约</text></view></view><view wx:if="{{currentCard.data.days.length}}" class="book-link" bindtap="addItinerary">加入行程</view></view><view wx:for="{{currentCard.data.services}}" wx:key="serviceId"><view>{{item.title}}</view><view wx:if="{{item.serviceId}}"><text data-service-id="{{item.serviceId}}" bindtap="openService">查看详情</text><text data-service-id="{{item.serviceId}}" bindtap="bookService">预约</text></view></view><view wx:if="{{currentCard.data.booking}}"><view>待确认预约：{{currentCard.data.booking.name || currentCard.data.booking.serviceName}}</view><text wx:if="{{currentCard.data.booking.demoData}}" class="demo">演示数据</text><text wx:if="{{currentCard.data.booking.serviceId}}" data-service-id="{{currentCard.data.booking.serviceId}}" bindtap="bookService">继续确认</text></view><view wx:if="{{currentCard.type==='error' && currentCard.data.demoAvailable}}" class="book-link" bindtap="showDemo">查看演示结果</view><view wx:if="{{currentCard.sources.length}}" class="sources" bindtap="toggleSources">参考了 {{currentCard.sources.length}} 条乌东资料<view wx:if="{{sourcesOpen}}" wx:for="{{currentCard.sources}}" wx:key="title">{{item.title}}</view></view></view><view wx:if="{{previousCard}}" class="sources" bindtap="togglePrevious">上一版<view wx:if="{{previousOpen}}">{{previousCard.title}} {{previousCard.summary}}</view></view></view>
