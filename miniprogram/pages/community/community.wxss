.actions{display:flex}.form,.post,.state{margin-top:22rpx;padding:24rpx;background:#fffdf8;border:1rpx solid rgba(49,95,75,.13);border-radius:20rpx}.field{display:flex;justify-content:space-between;gap:20rpx;min-height:82rpx;align-items:center;border-bottom:1rpx solid #ece6d9}.field input,.field textarea{flex:1;text-align:right}.ghost{color:#315f4b;background:transparent;border:1rpx solid #315f4b}.post-cover{width:100%;height:300rpx;margin-bottom:18rpx;border-radius:14rpx}.image-note{margin:-6rpx 0 15rpx;color:#8a654d;font-size:20rpx}.post-title{margin:12rpx 0;color:#173f36;font-size:30rpx;font-weight:700}.route{margin-top:18rpx;padding:18rpx;background:#edf1e7;border-radius:14rpx}.route>view{margin-top:10rpx}.route text{display:inline-grid;width:36rpx;height:36rpx;place-items:center;margin-right:10rpx;color:#fff;background:#c6734d;border-radius:50%}.notice,.tags{margin-top:14rpx;color:#795236;font-size:21rpx}.read-more{margin-top:18rpx}.error,.message{margin-top:20rpx;padding:18rpx;color:#933f31;background:#fff1ea;border-radius:14rpx}
.route-picker{margin-top:18rpx}.route-place-list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.route-place{display:flex;align-items:center;gap:8rpx;padding:10rpx 15rpx;border:1rpx solid #d5dfd5;border-radius:999rpx;color:#315f4b;background:#fff;font-size:22rpx}.route-place.active{color:#fff;border-color:#397f7a;background:#397f7a}.route-place text{display:grid;width:30rpx;height:30rpx;place-items:center;margin:0;color:inherit;background:rgba(49,95,75,.1);border-radius:50%;font-size:18rpx}.route-place.active text{background:rgba(255,255,255,.25)}
