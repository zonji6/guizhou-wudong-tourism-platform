.actions{display:flex}.form,.post,.state{margin-top:22rpx;padding:24rpx;background:#fffdf8;border:1rpx solid rgba(49,95,75,.13);border-radius:20rpx}.field{display:flex;justify-content:space-between;gap:20rpx;min-height:82rpx;align-items:center;border-bottom:1rpx solid #ece6d9}.field input,.field textarea{flex:1;text-align:right}.ghost{color:#315f4b;background:transparent;border:1rpx solid #315f4b}.post-title{margin:12rpx 0;color:#173f36;font-size:30rpx;font-weight:700}.route{margin-top:18rpx;padding:18rpx;background:#edf1e7;border-radius:14rpx}.route>view{margin-top:10rpx}.route text{display:inline-grid;width:36rpx;height:36rpx;place-items:center;margin-right:10rpx;color:#fff;background:#c6734d;border-radius:50%}.notice,.tags{margin-top:14rpx;color:#795236;font-size:21rpx}.error,.message{margin-top:20rpx;padding:18rpx;color:#933f31;background:#fff1ea;border-radius:14rpx}
