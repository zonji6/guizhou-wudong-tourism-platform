<view class="page"><view class="eyebrow">寨里</view><view class="title">听当地人讲山的故事</view><view class="muted">动态内容均为答辩演示数据。</view><view wx:for="{{posts}}" wx:key="id" class="post"><image wx:if="{{item.cover && !imageErrors[item.id]}}" src="{{item.cover}}" mode="aspectFill" aria-label="{{item.coverAlt}}" data-id="{{item.id}}" binderror="imageError"/><view wx:else role="img" aria-label="{{item.coverAlt}}" class="image-fallback">{{item.coverAlt}}</view><view class="post-body"><view class="author">{{item.author}}</view><view class="post-title">{{item.title}}</view><view class="muted">{{item.text}}</view><view class="likes">♡ {{item.likes}}</view></view></view></view>
