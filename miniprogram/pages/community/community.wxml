<view class="page">
  <view class="eyebrow">社区</view><view class="title">寨里分享与文化手账</view><view class="muted">文化文章来自资料整理；路线节点只引用公开地点，水彩位置不提供导航、里程或预计时长。</view>
  <view class="actions"><button class="primary" bindtap="toggleForm">{{formOpen ? '收起投稿' : '写一页手账'}}</button></view>
  <view wx:if="{{formOpen}}" class="form">
    <view wx:if="{{!loggedIn}}" class="muted">请先登录平台账号。<button class="ghost" bindtap="toProfile">去“我的”</button></view>
    <block wx:else>
      <picker range="{{postTypes}}" bindchange="setType"><view class="field">类型 <text>{{postType === 'MOMENT' ? '日常记录' : '示意路线攻略'}}</text></view></picker>
      <view wx:if="{{postType === 'ROUTE_GUIDE'}}" class="field"><text>标题</text><input value="{{title}}" data-field="title" bindinput="input"/></view>
      <view class="field"><text>正文</text><textarea value="{{content}}" data-field="content" bindinput="input"/></view>
      <view class="field"><text>标签</text><input value="{{tags}}" placeholder="村寨生活" data-field="tags" bindinput="input"/></view>
      <block wx:if="{{postType === 'ROUTE_GUIDE'}}"><view class="field"><text>路线说明</text><input value="{{routeSummary}}" data-field="routeSummary" bindinput="input"/></view><view class="route-picker"><view class="field"><text>公开地点（最多 12 个）</text><text>{{routePlaceIds.length ? '已选 ' + routePlaceIds.length + ' 个' : '点击地点加入路线'}}</text></view><view class="route-place-list"><view wx:for="{{routePlaces}}" wx:key="id" class="route-place {{item.routeOrder ? 'active' : ''}}" data-id="{{item.id}}" bindtap="toggleRoutePlace"><text>{{item.routeOrder || '+'}}</text>{{item.name}}</view></view></view><view class="muted">编号就是发布后的水彩示意顺序，再次点击可移除；不提供真实导航。</view></block>
      <button class="primary" loading="{{loading}}" bindtap="submit">发布</button>
    </block>
  </view>
  <view wx:if="{{loading && !posts.length}}" class="state">正在读取寨里内容…</view><view wx:elif="{{error}}" class="state error">{{error}}</view>
  <view wx:for="{{posts}}" wx:key="id" class="post">
    <image wx:if="{{item.displayCoverUrl}}" class="post-cover" src="{{item.displayCoverUrl}}" mode="aspectFill"/>
    <view wx:if="{{item.imageNote}}" class="image-note">{{item.imageNote}}</view>
    <view class="eyebrow">{{item.kindLabel}} · {{item.authorName}}</view><view class="post-title">{{item.title || '山里片刻'}}</view><view class="muted">{{item.excerpt}}</view>
    <view wx:if="{{item.postType === 'ROUTE_GUIDE'}}" class="route"><view>{{item.routeSummary}}</view><view wx:for="{{item.routeNodes}}" wx:for-item="node" wx:key="viewKey"><text>{{node.sequence}}</text>{{node.placeName}} {{node.drawable ? '' : '（仅文字，不绘制）'}}</view><view class="notice">水彩示意顺序，不提供真实导航。</view></view>
    <view class="tags">{{item.tagText}}</view><button class="ghost read-more" data-id="{{item.id}}" bindtap="openPost">阅读全文</button>
  </view>
  <view wx:if="{{!posts.length && !loading}}" class="state">寨里暂时没有公开分享。</view><view wx:if="{{message}}" class="message">{{message}}</view>
</view>
