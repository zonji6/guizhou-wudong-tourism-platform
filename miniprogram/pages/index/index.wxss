.brand-hero{position:relative;height:238rpx;overflow:hidden;background:#173f36}.brand-hero image{width:100%;height:100%;display:block}.brand-copy{position:absolute;left:28rpx;bottom:24rpx;color:#fffdf8;font-size:32rpx;font-weight:700;letter-spacing:4rpx;text-shadow:0 2rpx 8rpx rgba(0,0,0,.35)}.hero-fallback{height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#173f36,#315f4b);color:#f5e7cf;font-size:27rpx}.categories{display:grid;grid-template-columns:repeat(5,1fr);gap:9rpx;margin:24rpx 0}.category{padding:18rpx 4rpx;text-align:center;color:#315f4b;background:#fffdf8;border:1rpx solid #e8e0d2;border-radius:14rpx}.category text{display:block;color:#b56f3b;font-size:32rpx}.category view{margin-top:7rpx;font-size:22rpx}.category small{display:block;margin-top:5rpx;color:#718077;font-size:16rpx}.trip{padding:22rpx 28rpx;background:#173f36;color:#fffdf8;border-radius:999rpx;text-align:center;font-size:27rpx}.home-note{margin-top:28rpx;padding:26rpx;background:#fffdf8;border:1rpx solid rgba(49,95,75,.13);border-radius:20rpx}.home-note .muted{margin-top:12rpx;line-height:1.75}
