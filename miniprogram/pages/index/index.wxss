.hero { padding:82rpx 48rpx 70rpx; color:#fff; background:linear-gradient(135deg,#173d31,#56735b); }.light { color:#e7bf82; }.hero-title { font-size:54rpx; line-height:1.35; font-weight:700; margin:20rpx 0; }.hero-title text { color:#e7bf82; }.hero-sub { color:#e5eee7; font-size:27rpx; }.hero-button { width:270rpx; margin-top:34rpx; text-align:center; padding:18rpx; color:#284035; background:#d9a561; border-radius:4rpx; }.categories { display:grid; grid-template-columns:repeat(4,1fr); gap:12rpx; }.category { padding:20rpx 8rpx; text-align:center; color:#315f4b; background:#fffdf8; border:1rpx solid #e8e0d2; }.category text { display:block; font-size:35rpx; color:#b56f3b; }.category view { font-size:23rpx; margin:9rpx 0 4rpx; }.category small { color:#718077; font-size:18rpx; }.more { color:#315f4b; font-size:25rpx; }.service { display:flex; margin-bottom:20rpx; overflow:hidden; background:#fffdf8; box-shadow:0 7rpx 18rpx rgba(35,58,46,.07); }.service image { width:210rpx; height:166rpx; }.service-body { padding:20rpx; }.service-title { font-weight:600; font-size:28rpx; line-height:1.45; }.service-price { color:#b56f3b; margin-top:18rpx; }.service-price text { color:#718077; font-size:19rpx; }.community-link { margin:38rpx 0 20rpx; text-align:center; color:#315f4b; font-size:27rpx; }
