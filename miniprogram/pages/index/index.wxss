.brand-hero{position:relative;height:238rpx;overflow:hidden;background:#173f36}.brand-hero image{width:100%;height:100%;display:block}.brand-copy{position:absolute;left:28rpx;bottom:24rpx;color:#fffdf8;font-size:32rpx;font-weight:700;letter-spacing:4rpx;text-shadow:0 2rpx 8rpx rgba(0,0,0,.35)}.hero-fallback{height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#173f36,#315f4b);color:#f5e7cf;font-size:27rpx}.categories{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin:24rpx 0}.category{padding:20rpx 8rpx;text-align:center;color:#315f4b;background:#fffdf8;border:1rpx solid #e8e0d2;border-radius:8rpx}.category text{display:block;color:#b56f3b;font-size:35rpx}.category view{margin-top:8rpx;font-size:23rpx}.trip{padding:22rpx 28rpx;background:#173f36;color:#fffdf8;border-radius:999rpx;text-align:center;font-size:27rpx}.service{display:flex;min-height:166rpx;margin-bottom:20rpx;overflow:hidden;background:#fffdf8;border-radius:8rpx;box-shadow:0 7rpx 18rpx rgba(35,58,46,.07)}.service image,.service-fallback{width:210rpx;height:166rpx;flex:none}.service-fallback{display:flex;align-items:center;justify-content:center;padding:16rpx;box-sizing:border-box;background:#315f4b;color:#f5e7cf;font-size:22rpx;line-height:1.45;text-align:center}.service-body{padding:20rpx}.service-title{font-size:28rpx;font-weight:600;line-height:1.45}.service-price{margin-top:18rpx;color:#b56f3b}
