<view class="brand-hero"><image wx:if="{{!heroImageFailed}}" src="/assets/wudong-local/village.jpg" mode="aspectFill" aria-label="乌东苗寨实景" binderror="imageError"/><view wx:else role="img" aria-label="乌东苗寨实景暂不可用" class="hero-fallback">乌东苗寨实景暂不可用</view><view class="brand-copy">山静 · 人暖</view></view>
<view class="page"><view class="title">今天，想怎么游乌东？</view><view class="categories"><view wx:for="{{categories}}" wx:key="id" class="category" data-category="{{item.id}}" bindtap="toResources"><text>{{item.icon}}</text><view>{{item.name}}</view></view></view><view wx:if="{{currentItinerary || pendingBooking}}" class="trip" bindtap="toAssistant">继续上次行程</view><view wx:else class="trip" bindtap="toAssistant">让向导为我安排</view><view class="section-head"><view class="section-title">精选体验</view><text class="demo">演示数据</text></view><view wx:for="{{services}}" wx:key="id" class="service" data-id="{{item.id}}" bindtap="toDetail"><image wx:if="{{item.image && !serviceImageErrors[item.id]}}" src="{{item.image}}" mode="aspectFill" aria-label="{{item.imageAlt}}" data-id="{{item.id}}" binderror="serviceImageError"/><view wx:else role="img" aria-label="乌东{{item.categoryLabel}}服务实景暂缺" class="service-fallback">乌东{{item.categoryLabel}}服务实景暂缺</view><view class="service-body"><view class="service-title">{{item.title}}</view><view class="service-price">¥{{item.price}} 起</view></view></view></view>
