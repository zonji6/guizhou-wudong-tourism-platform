.auth-card,.account-card,.summary{margin-top:22rpx;padding:24rpx;background:#fffdf8;border:1rpx solid rgba(49,95,75,.13);border-radius:20rpx}.switch{display:grid;grid-template-columns:1fr 1fr;gap:10rpx}.switch button{color:#315f4b;background:#edf1e7}.switch button.active{color:#fff;background:#315f4b}.field{display:flex;justify-content:space-between;align-items:center;min-height:84rpx;border-bottom:1rpx solid #ece6d9}.field input{flex:1;text-align:right}.ghost{margin-top:18rpx;color:#315f4b;background:transparent;border:1rpx solid #315f4b}.card-title{font-size:34rpx;font-weight:700;color:#173f36;margin:10rpx 0}.actions{display:flex;gap:14rpx}.actions button{flex:1}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.summary{text-align:center}.summary text{color:#b55e3e;font-size:48rpx;font-weight:700}.message{margin-top:20rpx;padding:18rpx;color:#933f31;background:#fff1ea;border-radius:14rpx}
