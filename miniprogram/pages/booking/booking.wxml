<view class="page booking-page">
  <view class="eyebrow">先核价，再提交</view><view class="title">{{selection.title || '订单确认'}}</view><view class="muted">核价不锁库存、餐位或房态；正式提交后才生成订单。</view>
  <view wx:if="{{!selection}}" class="panel"><view class="card-title">当前没有待确认内容</view><view class="muted">请返回五模块目录重新选择；页面不会自动重放上一笔操作。</view></view>
  <view wx:elif="{{receipt}}" class="panel success"><view class="eyebrow">订单提交成功</view><view class="title">{{receipt.resource.productName || receipt.resource.merchantName || receipt.resource.roomTypeName}}</view><view>订单编号：{{receipt.resource.id}}</view><view>状态：{{receipt.resource.statusLabel}}</view><view>金额：¥{{receipt.resource.totalAmount}} {{receipt.resource.currency}}</view><view class="muted">{{receipt.replayed ? '已安全返回同一次提交结果' : '订单已保存'}}</view><button class="primary" bindtap="toOrders">查看我的订单</button></view>
  <block wx:elif="{{selection}}">
    <view wx:if="{{!loggedIn}}" class="panel"><view class="card-title">请先登录平台账号</view><view class="muted">网页端和小程序使用同一账号查看订单、草稿与行程。</view><button class="primary" bindtap="toProfile">去“我的”登录</button></view>
    <view wx:else class="panel"><view class="section-title">1. 选择条件</view><view wx:if="{{selection.kind === 'food'}}" class="line" wx:for="{{selection.items}}" wx:key="foodItemId"><text>{{item.resource.name}}</text><text>{{item.quantity}} 份</text></view><view class="field" wx:if="{{selection.kind === 'product'}}"><text>商品数量</text><input disabled="{{submitting || attemptLocked}}" type="number" min="1" value="{{quantity}}" data-field="quantity" bindinput="change"/></view><block wx:elif="{{selection.kind === 'food'}}"><view class="field"><text>到店日期</text><picker disabled="{{submitting || attemptLocked}}" mode="date" value="{{visitDate}}" data-field="visitDate" bindchange="change"><view>{{visitDate || '请选择'}}</view></picker></view><view class="field"><text>到店时间</text><picker disabled="{{submitting || attemptLocked}}" mode="time" value="{{visitTime}}" data-field="visitTime" bindchange="change"><view>{{visitTime || '请选择'}}</view></picker></view><view class="field"><text>到店人数</text><input disabled="{{submitting || attemptLocked}}" type="number" min="1" value="{{peopleCount}}" data-field="peopleCount" bindinput="change"/></view></block><block wx:else><view class="muted">{{selection.resource.name}} · 每间演示容量 {{selection.resource.maxGuestsPerRoom}} 人</view><view class="field"><text>入住日期</text><picker disabled="{{submitting || attemptLocked}}" mode="date" value="{{checkInDate}}" data-field="checkInDate" bindchange="change"><view>{{checkInDate || '请选择'}}</view></picker></view><view class="field"><text>离店日期</text><picker disabled="{{submitting || attemptLocked}}" mode="date" value="{{checkOutDate}}" data-field="checkOutDate" bindchange="change"><view>{{checkOutDate || '请选择'}}</view></picker></view><view class="field"><text>房间数</text><input disabled="{{submitting || attemptLocked}}" type="number" min="1" value="{{roomCount}}" data-field="roomCount" bindinput="change"/></view><view class="field"><text>入住人数</text><input disabled="{{submitting || attemptLocked}}" type="number" min="1" value="{{peopleCount}}" data-field="peopleCount" bindinput="change"/></view></block><button class="primary" disabled="{{loading || submitting || attemptLocked}}" loading="{{loading}}" bindtap="getQuote">获取模拟核价</button></view>
    <view wx:if="{{quote}}" class="panel"><view class="section-title">2. 核对与提交</view><view class="total">¥{{quote.totalAmount}} <text>{{quote.currency}}</text></view><view wx:if="{{needsReconfirm && oldTotal}}" class="muted">此前显示：¥{{oldTotal}}</view><view class="line" wx:for="{{quote.lines}}" wx:key="sequence"><text>{{item.resourceName}} × {{item.quantity}}</text><text>¥{{item.lineAmount}}</text></view><view class="notice">{{quote.notice}}</view><button wx:if="{{needsReconfirm}}" class="primary" bindtap="acceptChangedQuote">我已核对新报价</button><block wx:else><view class="field"><text>联系人</text><input disabled="{{submitting || attemptLocked}}" value="{{contactName}}" data-field="contactName" bindinput="input"/></view><view class="field"><text>联系电话</text><input disabled="{{submitting || attemptLocked}}" value="{{contactPhone}}" data-field="contactPhone" bindinput="input"/></view><view class="field"><text>备注</text><input disabled="{{submitting || attemptLocked}}" value="{{note}}" data-field="note" bindinput="input"/></view><button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{attemptLocked ? '安全重试提交' : '确认并提交订单'}}</button></block></view>
  </block>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
