<view class="page"><view class="eyebrow">预约确认</view><view class="title">留一席山里的慢时光</view><view wx:if="{{pendingLoading}}" class="pending">正在读取待确认预约</view><view wx:elif="{{item && !pendingLoadError}}" class="booking"><view class="item"><image wx:if="{{item.image && !imageFailed}}" src="{{item.image}}" mode="aspectFill" aria-label="{{item.imageAlt}}" binderror="imageError"/><view wx:else role="img" aria-label="{{item.imageAlt}}" class="image-fallback">{{item.imageAlt}}</view><view>{{item.title}}</view></view><view wx:if="{{!done}}"><view class="field"><text>日期</text><picker mode="date" value="{{date}}" bindchange="dateChange"><view>{{date}}</view></picker></view><view class="field"><text>人数</text><input type="number" value="{{people}}" bindinput="peopleChange"/></view><view class="field"><text>联系人</text><input value="{{contact}}" bindinput="contactChange"/></view><view class="field"><text>联系电话</text><input value="{{phone}}" bindinput="phoneChange"/></view><view wx:if="{{actionError}}" class="error">{{actionError}}</view><view wx:if="{{!pending}}" class="primary" bindtap="submit">提交待确认预约</view><view wx:else><view class="pending">预约已创建，状态：{{pending.status}}</view><view class="primary" bindtap="confirm">确认这笔预约</view></view></view><view wx:else class="done"><view class="title">预约已确认</view><view class="primary" bindtap="orders">查看我的订单</view></view></view><view wx:else><view class="error">{{pendingLoadError || '未找到可预约服务'}}</view><navigator open-type="navigateBack">返回重试</navigator></view></view>
