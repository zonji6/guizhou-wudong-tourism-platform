<view class="page"><view class="eyebrow">预约确认</view><view class="title">留一席山里的慢时光</view><view wx:if="{{!done}}" class="booking"><view class="item"><image src="{{item.image}}" mode="aspectFill"/><view><view class="item-title">{{item.title}}</view><view class="service-price">¥{{item.price}} 起 · 演示价格</view></view></view><view class="field"><text>日期</text><picker mode="date" value="{{date}}" bindchange="dateChange"><view>{{date}}</view></picker></view><view class="field"><text>人数</text><input type="number" value="{{people}}" bindinput="peopleChange"/></view><view class="field"><text>联系人</text><input value="{{contact}}" bindinput="contactChange"/></view><view class="primary" bindtap="submit">确认提交预约</view><view class="tip">提交后生成演示订单；真实订单由 Java 服务确认。</view></view><view wx:else class="done"><text>✓</text><view class="title">预约申请已提交</view><view class="muted">演示订单已进入“待确认”。</view><view class="primary" bindtap="orders">查看我的订单</view></view></view>
