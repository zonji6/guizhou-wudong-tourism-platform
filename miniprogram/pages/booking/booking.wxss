.booking-page{padding-top:38rpx}.panel{margin-top:24rpx;padding:26rpx;background:#fffdf8;border:1rpx solid rgba(49,95,75,.13);border-radius:22rpx}.card-title,.section-title{color:#173f36;font-size:29rpx;font-weight:700}.field,.line{display:flex;justify-content:space-between;align-items:center;gap:20rpx;min-height:82rpx;border-bottom:1rpx solid #ece6d9}.field input,.field picker{flex:1;text-align:right}.total{margin:20rpx 0;color:#b55e3e;font-size:58rpx;font-weight:700}.total text{font-size:22rpx}.notice{margin:20rpx 0;padding:18rpx;color:#795236;background:#f7ead4;border-radius:14rpx}.error{margin-top:20rpx;padding:18rpx;color:#933f31;background:#fff1ea;border-radius:14rpx}.success{text-align:center}.success>view{margin-top:12rpx}
