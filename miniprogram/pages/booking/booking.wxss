.booking { margin-top:22rpx; padding:24rpx; background:#fffdf8; }.item { display:flex; gap:18rpx; padding-bottom:22rpx; border-bottom:1rpx solid #ece6d9; }.item image { width:150rpx; height:115rpx; }.item-title { font-weight:600; font-size:28rpx; line-height:1.45; }.service-price { color:#b56f3b; margin-top:17rpx; }.field { display:flex; justify-content:space-between; padding:26rpx 0; border-bottom:1rpx solid #ece6d9; }.field text { color:#315f4b; }.field input { text-align:right; }.tip { color:#718077; margin-top:18rpx; font-size:21rpx; }.done { padding:70rpx 20rpx; text-align:center; background:#fffdf8; }.done > text { display:inline-flex; justify-content:center; align-items:center; width:92rpx; height:92rpx; margin-bottom:22rpx; color:#fff; background:#315f4b; border-radius:50%; font-size:50rpx; }
