<view class="page">
  <view class="eyebrow">我的乌东行程</view>
  <view class="title">预约订单</view>
  <view class="muted">以下为本机答辩演示订单。</view>

  <view wx:if="{{orders.length}}">
    <view wx:for="{{orders}}" wx:key="id" class="order">
      <view class="order-head">
        <text>{{item.id}}</text>
        <text>
          {{item.status === 'PENDING_CONFIRMATION' ? '待你确认' : item.status === 'CONFIRMED' ? '已确认' : item.status === 'PROCESSING' ? '服务方处理中' : item.status === 'COMPLETED' ? '已完成' : item.status === 'CANCELLED' ? '已取消' : '等待处理'}}
        </text>
      </view>
      <view class="order-name">{{item.name}}</view>
      <view class="muted">{{item.date}} · {{item.people}} 人</view>
      <text wx:if="{{item.demoData}}" class="demo">演示数据</text>
    </view>
  </view>
  <view wx:else class="order">还没有预约订单。</view>
</view>
