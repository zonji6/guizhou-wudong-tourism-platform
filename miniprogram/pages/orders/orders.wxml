<view class="page">
  <view class="eyebrow">我的乌东</view><view class="title">订单、草稿与行程</view>
  <view wx:if="{{!loggedIn}}" class="state">请先登录平台账号。<button class="primary" bindtap="toProfile">去“我的”</button></view>
  <block wx:else>
    <view class="tabs"><button class="{{tab === 'orders' ? 'active' : ''}}" data-tab="orders" bindtap="changeTab">三类订单</button><button class="{{tab === 'drafts' ? 'active' : ''}}" data-tab="drafts" bindtap="changeTab">食宿草稿</button><button class="{{tab === 'itineraries' ? 'active' : ''}}" data-tab="itineraries" bindtap="changeTab">行程</button><button class="{{tab === 'legacy' ? 'active' : ''}}" data-tab="legacy" bindtap="changeTab">旧记录</button></view>
    <view wx:if="{{loading}}" class="state">正在读取…</view><view wx:elif="{{error}}" class="state error">{{error}}</view>
    <block wx:elif="{{tab === 'orders'}}"><view wx:for="{{orders}}" wx:key="id" class="card"><view class="head"><text>{{item.typeLabel}}</text><text>{{item.statusLabel}}</text></view><view class="card-title">{{item.title}}</view><view class="muted">{{item.summary}}</view><view class="price">¥{{item.totalAmount}} {{item.currency}}</view></view><view wx:if="{{!orders.length}}" class="state">还没有正式订单。</view></block>
    <block wx:elif="{{tab === 'drafts'}}">
      <view wx:for="{{drafts}}" wx:key="id" class="card"><view class="head"><text>{{item.draftTypeLabel}}草稿</text><text>{{item.stateLabel}}</text></view><view class="card-title">保存版本 {{item.version}}</view><view class="muted">{{item.state === 'SUBMITTED' ? '已关联正式订单，当前草稿只读' : '可在网页端和小程序继续编辑'}}</view><button wx:if="{{item.state === 'DRAFT'}}" class="ghost" data-id="{{item.id}}" bindtap="openDraft">继续编辑</button></view>
      <view wx:if="{{!drafts.length}}" class="state">还没有食宿草稿。</view>
      <view wx:if="{{draftEditor}}" class="editor">
        <view class="head"><text>{{draftEditor.draftTypeLabel}}草稿</text><text>版本 {{draftEditor.version}}</text></view>
        <block wx:if="{{draftEditor.draftType === 'FOOD'}}">
          <view class="muted">同店 {{draftEditor.content.items.length}} 项；店铺与已选餐食保持不变。</view>
          <view wx:for="{{draftEditor.content.items}}" wx:for-item="food" wx:for-index="foodIndex" wx:key="foodItemId" class="field"><text>餐食 {{foodIndex + 1}}</text><input type="number" min="1" value="{{food.quantity}}" data-index="{{foodIndex}}" disabled="{{submitting || submitLocked}}" bindinput="editItemQuantity" /></view>
          <view class="field"><text>到店时间</text><input value="{{draftEditor.content.visitAt}}" placeholder="YYYY-MM-DDTHH:mm:ss" data-field="visitAt" disabled="{{submitting || submitLocked}}" bindinput="editField" /></view>
          <view class="field"><text>人数</text><input type="number" min="1" value="{{draftEditor.content.peopleCount}}" data-field="peopleCount" disabled="{{submitting || submitLocked}}" bindinput="editField" /></view>
        </block>
        <block wx:else>
          <view class="muted">原房型保持不变。</view>
          <view class="field"><text>入住日期</text><input value="{{draftEditor.content.checkInDate}}" placeholder="YYYY-MM-DD" data-field="checkInDate" disabled="{{submitting || submitLocked}}" bindinput="editField" /></view>
          <view class="field"><text>离店日期</text><input value="{{draftEditor.content.checkOutDate}}" placeholder="YYYY-MM-DD" data-field="checkOutDate" disabled="{{submitting || submitLocked}}" bindinput="editField" /></view>
          <view class="field"><text>房间数</text><input type="number" min="1" value="{{draftEditor.content.roomCount}}" data-field="roomCount" disabled="{{submitting || submitLocked}}" bindinput="editField" /></view>
          <view class="field"><text>人数</text><input type="number" min="1" value="{{draftEditor.content.peopleCount}}" data-field="peopleCount" disabled="{{submitting || submitLocked}}" bindinput="editField" /></view>
        </block>
        <view class="field"><text>联系人</text><input maxlength="80" value="{{draftEditor.content.contactName}}" data-field="contactName" disabled="{{submitting || submitLocked}}" bindinput="editField" /></view>
        <view class="field"><text>联系电话</text><input maxlength="32" value="{{draftEditor.content.contactPhone}}" data-field="contactPhone" disabled="{{submitting || submitLocked}}" bindinput="editField" /></view>
        <view class="field"><text>备注</text><textarea maxlength="500" value="{{draftEditor.content.note}}" data-field="note" disabled="{{submitting || submitLocked}}" bindinput="editField" /></view>
        <view class="muted {{savePaused ? 'error-text' : ''}}">{{saveStatus}}</view>
        <button wx:if="{{savePaused}}" class="primary" disabled="{{saving}}" bindtap="continueSave">{{saveUnknown ? '继续保存（先核对原结果）' : '重新尝试保存'}}</button>
        <view class="submit-box"><button class="ghost" disabled="{{submitting || submitLocked || saving || savePaused}}" bindtap="quoteDraft">按已保存版本核价</button><view wx:if="{{oldQuote}}" class="muted">旧报价：¥{{oldQuote.totalAmount}} {{oldQuote.currency}}</view><view wx:if="{{quote}}" class="quote"><view>当前报价：¥{{quote.totalAmount}} {{quote.currency}}</view><view class="muted">{{quote.notice}}</view><button class="primary" disabled="{{submitting}}" bindtap="submitDraft">{{submitting ? '提交中…' : submitLocked ? '安全重试提交' : oldQuote ? '确认新报价并提交' : '确认该报价并提交'}}</button></view><view wx:if="{{submitStatus}}" class="muted">{{submitStatus}}</view></view>
        <button class="link" bindtap="closeDraft">关闭编辑器</button>
      </view>
    </block>
    <block wx:elif="{{tab === 'itineraries'}}"><view wx:for="{{itineraries}}" wx:key="id" class="card"><view class="head"><text>已保存行程</text><text>v{{item.version}}</text></view><view class="card-title">{{item.content.title}}</view><view class="muted">{{item.content.days.length}} 天 · {{item.content.travelDate || '日期待定'}}</view><button class="ghost" disabled="{{tripEditor}}" data-id="{{item.id}}" bindtap="openTrip">调整行程</button></view><view wx:if="{{!itineraries.length}}" class="state">还没有已保存行程。</view><view wx:if="{{tripEditor}}" class="editor trip-editor"><view class="head"><text>手动调整行程</text><text>v{{tripEditor.version}}</text></view><view class="field"><text>行程标题</text><input value="{{tripEditor.content.title}}" maxlength="80" data-field="title" bindinput="editTripMeta" /></view><view class="field"><text>出行日期</text><input value="{{tripEditor.content.travelDate}}" placeholder="YYYY-MM-DD" data-field="travelDate" bindinput="editTripMeta" /></view><view class="field"><text>人数</text><input type="number" min="1" value="{{tripEditor.content.peopleCount}}" data-field="peopleCount" bindinput="editTripMeta" /></view><view wx:for="{{tripEditor.content.days}}" wx:for-item="day" wx:for-index="dayIndex" wx:key="day" class="trip-day"><view class="field"><text>第 {{day.day}} 天主题</text><input value="{{day.theme}}" maxlength="80" data-day-index="{{dayIndex}}" bindinput="editTripDayTheme" /></view><view wx:for="{{day.stops}}" wx:for-item="stop" wx:for-index="stopIndex" wx:key="sequence" class="trip-stop"><text>{{stopIndex + 1}}</text><view><input value="{{stop.title}}" maxlength="120" placeholder="停留地点或安排" data-day-index="{{dayIndex}}" data-stop-index="{{stopIndex}}" data-field="title" bindinput="editTripStop" /><textarea value="{{stop.note}}" maxlength="500" placeholder="给自己留一句提醒" data-day-index="{{dayIndex}}" data-stop-index="{{stopIndex}}" data-field="note" bindinput="editTripStop" /></view><view class="trip-actions"><button data-day-index="{{dayIndex}}" data-stop-index="{{stopIndex}}" data-direction="-1" disabled="{{stopIndex === 0}}" bindtap="moveTripStop">上移</button><button data-day-index="{{dayIndex}}" data-stop-index="{{stopIndex}}" data-direction="1" disabled="{{stopIndex === day.stops.length - 1}}" bindtap="moveTripStop">下移</button><button data-day-index="{{dayIndex}}" data-stop-index="{{stopIndex}}" bindtap="removeTripStop">移除</button></view></view><button class="ghost" data-day-index="{{dayIndex}}" bindtap="addTripStop">添加一站</button></view><view class="muted {{tripMessage.indexOf('失败') >= 0 ? 'error-text' : ''}}">{{tripMessage}}</view><button class="primary" loading="{{tripSaving}}" bindtap="saveTrip">保存行程修改</button><button class="link" disabled="{{tripSaving}}" bindtap="closeTrip">关闭编辑器</button></view></block>
    <block wx:else><view wx:for="{{legacy}}" wx:key="id" class="card"><view class="head"><text>合法旧记录</text><text>只读</text></view><view class="card-title">{{item.title || item.name || item.id}}</view></view><view wx:if="{{!legacy.length}}" class="state">没有归属于当前账号的旧记录。</view></block>
  </block>
</view>
