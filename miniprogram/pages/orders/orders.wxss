.tabs{display:flex;gap:8rpx;margin:24rpx 0}.tabs button{flex:1;padding:14rpx 6rpx;color:#315f4b;background:#edf1e7;font-size:21rpx}.tabs button.active{color:#fff;background:#315f4b}.card,.state{margin-top:18rpx;padding:24rpx;background:#fffdf8;border:1rpx solid rgba(49,95,75,.13);border-radius:18rpx}.head{display:flex;justify-content:space-between;color:#b55e3e;font-size:21rpx}.card-title{margin:14rpx 0;color:#173f36;font-size:28rpx;font-weight:700}.price{margin-top:14rpx;color:#b55e3e}.error{color:#933f31;background:#fff1ea}
.editor{margin-top:24rpx;padding:26rpx;background:#fffaf0;border:2rpx solid rgba(181,94,62,.2);border-radius:24rpx}.field{display:grid;gap:8rpx;margin-top:20rpx;color:#315f4b;font-size:23rpx}.field input,.field textarea{box-sizing:border-box;width:100%;padding:18rpx;background:#fff;border:1rpx solid rgba(49,95,75,.2);border-radius:14rpx;color:#173f36}.field textarea{min-height:130rpx}.submit-box{display:grid;gap:14rpx;margin-top:24rpx;padding-top:22rpx;border-top:1rpx dashed rgba(181,94,62,.35)}.quote{display:grid;gap:12rpx;color:#b55e3e;font-weight:700}.error-text{color:#933f31}.ghost,.link{margin-top:18rpx}
.trip-editor{background:linear-gradient(145deg,#fffdf8,#eef5ed);border-color:rgba(57,127,122,.24)}.trip-day{display:grid;gap:14rpx;margin-top:24rpx;padding:20rpx;border-left:6rpx solid #a9c8ad;background:#fffdf8}.trip-stop{display:grid;grid-template-columns:42rpx 1fr;gap:14rpx;padding:16rpx 0;border-top:1rpx dashed rgba(49,95,75,.16)}.trip-stop>text{display:grid;width:36rpx;height:36rpx;place-items:center;color:#fff;background:#397f7a;border-radius:50%;font-size:20rpx}.trip-stop>view:nth-child(2){display:grid;gap:10rpx}.trip-stop input,.trip-stop textarea{box-sizing:border-box;width:100%;padding:14rpx;border:1rpx solid rgba(49,95,75,.2);border-radius:12rpx;background:#fff}.trip-stop textarea{min-height:100rpx}.trip-actions{grid-column:2;display:flex;gap:10rpx}.trip-actions button{margin:0;padding:10rpx 14rpx;color:#557b6d;background:#edf4ed;font-size:21rpx}
