<view class="page"><view class="eyebrow">游乌东</view><view class="title">把时间留给山与人</view><scroll-view class="filters" scroll-x><view class="filter {{active === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="filter">{{item.name}}</view></scroll-view><view class="service" wx:for="{{services}}" wx:key="id" data-id="{{item.id}}" bindtap="toDetail"><image wx:if="{{item.image && !imageErrors[item.id]}}" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="imageError"/><view wx:else role="img" aria-label="服务实景暂缺" class="image-fallback">服务实景暂缺</view><view><view class="service-title">{{item.title}}</view><view class="service-intro">{{item.intro}}</view><view class="service-price">¥{{item.price}} 起 <text>演示价格</text></view></view></view></view>
