<view class="page">
  <view class="eyebrow">逛乌东 · 五模块</view><view class="title">沿着山路，慢慢遇见乌东</view><view class="muted">公共目录来自 v3 本机服务，失败时不会用假资源补位。</view>
  <scroll-view class="filters" scroll-x><view wx:for="{{tabs}}" wx:key="id" class="filter {{active === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeTab">{{item.name}}</view></scroll-view>
  <view wx:if="{{loading}}" class="state">正在读取内容…</view><view wx:elif="{{error}}" class="state error">{{error}}</view>

  <block wx:elif="{{active === 'product'}}"><view wx:for="{{products}}" wx:key="id" class="resource-card"><view><view class="eyebrow">{{item.merchantName}}</view><view class="card-title">{{item.name}}</view><view class="muted">{{item.description}}</view><view wx:if="{{item.priceView}}" class="price">¥{{item.priceView.amount}} <text>{{item.priceView.kind}} · {{item.priceView.note}}</text></view><view wx:else class="muted">暂无可展示价格</view></view><button class="primary" disabled="{{!item.orderable}}" data-id="{{item.id}}" bindtap="checkoutProduct">{{item.orderable ? '选择数量并核价' : '暂不可提交'}}</button></view><view wx:if="{{!products.length}}" class="state">当前没有已发布商品。</view></block>

  <block wx:elif="{{active === 'food'}}"><view class="section-title">先选一家店</view><view class="merchant {{selectedMerchant && selectedMerchant.id === item.id ? 'active' : ''}}" wx:for="{{merchants}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseMerchant"><view class="card-title">{{item.name}}</view><view class="muted">{{item.description}}</view></view><view wx:if="{{selectedMerchant}}" class="menu"><view class="section-head"><view><view class="eyebrow">同店多菜</view><view class="section-title">{{selectedMerchant.name}}</view></view></view><view class="menu-row" wx:for="{{foods}}" wx:key="id"><view><view class="card-title">{{item.name}}</view><view class="muted">{{item.description}}</view><view wx:if="{{item.priceView}}" class="price">¥{{item.priceView.amount}} / 份<text>{{item.priceView.note}}</text></view></view><input type="number" min="0" value="{{item.quantity}}" disabled="{{!item.orderable}}" data-index="{{index}}" bindinput="quantityChange"/></view><button class="primary" bindtap="checkoutFood">去填写到店信息并核价</button></view></block>

  <block wx:elif="{{active === 'stay'}}"><view wx:for="{{stays}}" wx:key="id" class="resource-card"><view class="eyebrow">{{item.locationText || item.merchantName}}</view><view class="card-title">{{item.name}}</view><view class="muted">{{item.description}}</view><button wx:for="{{item.roomTypes}}" wx:for-item="room" wx:key="id" class="room" disabled="{{!room.orderable}}" data-property-id="{{item.id}}" data-room-id="{{room.id}}" bindtap="checkoutStay"><view><text>{{room.name}}</text><text class="muted">每间演示容量 {{room.maxGuestsPerRoom}} 人</text></view><text wx:if="{{room.priceView}}">¥{{room.priceView.amount}} / 间夜</text><text wx:else>暂无演示价</text></button></view></block>

  <block wx:else><view class="map-head"><view class="eyebrow">{{map.mapMode}}</view><view class="section-title">乌东水彩示意图</view><view class="muted">{{map.notice}}</view></view><view class="map-canvas"><view wx:for="{{map.places}}" wx:key="id" wx:if="{{item.schematicPosition}}" class="map-pin" style="left: {{item.left}}%; top: {{item.top}}%;"><text></text>{{item.name}}</view></view><view class="place" wx:for="{{map.places}}" wx:key="id"><view class="card-title">{{item.name}}</view><view class="muted">{{item.category}} · {{item.description}}</view><text wx:if="{{!item.schematicPosition}}">仅文字节点，未绘制位置</text></view></block>
</view>
