<view class="page"><view class="eyebrow">乌冬体验清单</view><view class="title">把时间留给山与人</view><view class="muted">以下资源、价格为答辩演示数据。</view><scroll-view class="filters" scroll-x><view class="filter {{active === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="filter">{{item.name}}</view></scroll-view><view class="service" wx:for="{{services}}" wx:key="id" data-id="{{item.id}}" bindtap="toDetail"><image src="{{item.image}}" mode="aspectFill"/><view><view class="service-title">{{item.title}}</view><view class="service-intro">{{item.intro}}</view><view class="service-price">¥{{item.price}} 起 <text>演示价格</text></view></view></view></view>
