<view class="page">
  <view class="eyebrow">逛乌东 · 五模块</view>
  <view class="title">沿着山路，慢慢遇见乌东</view>
  <view class="muted">这里展示当前公开内容；演示价格、容量和示意路线均以页面说明为准。</view>
  <scroll-view class="filters" scroll-x>
    <view wx:for="{{tabs}}" wx:key="id" class="filter {{active === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changeTab">{{item.name}}</view>
  </scroll-view>
  <view wx:if="{{loading}}" class="state">正在读取内容…</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>

  <block wx:elif="{{active === 'product'}}">
    <view class="search-box"><input value="{{productQuery}}" placeholder="搜索商品、商家或标签" bindinput="productSearch"/></view>
    <scroll-view class="subfilters" scroll-x>
      <view class="subfilter {{!productTag ? 'active' : ''}}" data-tag="" bindtap="selectProductTag">全部</view>
      <view wx:for="{{productTags}}" wx:key="*this" class="subfilter {{productTag === item ? 'active' : ''}}" data-tag="{{item}}" bindtap="selectProductTag">{{item}}</view>
    </scroll-view>
    <view class="count-note">{{productSummary}}</view>
    <view wx:for="{{visibleProducts}}" wx:key="id" class="resource-card">
      <image wx:if="{{item.displayImageUrl}}" class="card-image" src="{{item.displayImageUrl}}" mode="aspectFill"/>
      <view wx:else class="card-image image-empty">图片暂缺</view>
      <view class="image-note" wx:if="{{item.imageNote}}">{{item.imageNote}}</view>
      <view class="eyebrow">{{item.merchantName}}</view>
      <view class="card-title">{{item.name}}</view>
      <view class="tag-row"><text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view>
      <view class="muted">{{item.description}}</view>
      <view wx:if="{{item.priceView}}" class="price">¥{{item.priceView.amount}} <text>{{item.priceView.kind}} · {{item.priceView.note}}</text></view>
      <view wx:else class="muted">暂无可展示价格</view>
      <view class="card-actions"><button class="ghost" data-kind="product" data-id="{{item.id}}" bindtap="openDetail">查看详情</button><button class="primary" disabled="{{!item.orderable}}" data-id="{{item.id}}" bindtap="checkoutProduct">{{item.orderable ? '选择数量并核价' : '暂不可提交'}}</button></view>
    </view>
    <view wx:if="{{!visibleProducts.length}}" class="state">没有符合条件的已发布商品。</view>
  </block>

  <block wx:elif="{{active === 'food'}}">
    <view class="section-title">先选一家店</view>
    <view class="search-box"><input value="{{merchantQuery}}" placeholder="搜索店名、菜品或标签" bindinput="merchantSearch"/></view>
    <view class="count-note">{{merchantSummary}}</view>
    <view class="merchant {{selectedMerchant && selectedMerchant.id === item.id ? 'active' : ''}}" wx:for="{{visibleMerchants}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseMerchant">
      <image wx:if="{{item.displayImageUrl}}" class="merchant-image" src="{{item.displayImageUrl}}" mode="aspectFill"/>
      <view><view class="card-title">{{item.name}}</view><view class="muted">{{item.description}}</view><view class="image-note" wx:if="{{item.imageNote}}">{{item.imageNote}}</view></view>
    </view>
    <view wx:if="{{merchants.length && !visibleMerchants.length}}" class="state">没有匹配的店铺，试试清空关键词。</view>
    <view id="food-menu" wx:if="{{selectedMerchant}}" class="menu">
      <view class="eyebrow">同店多菜</view><view class="section-title">{{selectedMerchant.name}}</view>
      <scroll-view class="subfilters" scroll-x><view wx:for="{{foodCategories}}" wx:key="id" class="subfilter {{foodCategory === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectFoodCategory">{{item.name}}</view></scroll-view>
      <view class="menu-row" wx:for="{{visibleFoods}}" wx:key="id">
        <image wx:if="{{item.displayImageUrl}}" class="menu-image" src="{{item.displayImageUrl}}" mode="aspectFill"/>
        <view><view class="eyebrow">{{item.itemTypeLabel}}</view><view class="card-title">{{item.name}}</view><view class="muted">{{item.description}}</view><view class="image-note" wx:if="{{item.imageNote}}">{{item.imageNote}}</view><view wx:if="{{item.priceView}}" class="price">¥{{item.priceView.amount}} / 份<text>{{item.priceView.note}}</text></view></view>
        <input type="number" min="0" max="99" value="{{item.quantity}}" disabled="{{!item.orderable}}" data-id="{{item.id}}" bindinput="quantityChange"/>
      </view>
      <view wx:if="{{!visibleFoods.length}}" class="state">这一分类暂时没有可选餐食。</view>
      <button class="primary" bindtap="checkoutFood">去填写到店信息并核价</button>
    </view>
  </block>

  <block wx:elif="{{active === 'stay'}}">
    <view class="search-box"><input value="{{stayQuery}}" placeholder="搜索住宿、房型、位置或标签" bindinput="staySearch"/></view>
    <view class="stay-people"><text>单间入住人数</text><input type="number" min="1" max="6" value="{{stayPeople}}" placeholder="不限" bindinput="stayPeopleChange"/><text>人</text></view>
    <view class="count-note">{{staySummary}}；容量和价格均为演示信息，不代表实时房态。</view>
    <view wx:for="{{visibleStays}}" wx:key="id" class="resource-card">
      <image wx:if="{{item.displayImageUrl}}" class="card-image" src="{{item.displayImageUrl}}" mode="aspectFill"/>
      <view wx:else class="card-image image-empty">图片暂缺</view>
      <view class="image-note" wx:if="{{item.imageNote}}">{{item.imageNote}}</view><view class="eyebrow">{{item.locationText || item.merchantName}}</view><view class="card-title">{{item.name}}</view><view class="muted">{{item.description}}</view>
      <view class="room-summary">{{item.roomTypes.length}} 个公开房型</view>
      <button class="primary" data-kind="stay" data-id="{{item.id}}" bindtap="openDetail">查看住宿与房型</button>
    </view>
    <view wx:if="{{stays.length && !visibleStays.length}}" class="state">没有符合条件的住宿，试试清空关键词或人数。</view><view wx:if="{{!stays.length}}" class="state">当前没有已发布住宿。</view>
  </block>

  <block wx:else>
    <view class="map-head"><view class="eyebrow">水彩示意</view><view class="section-title">乌东地点与慢游路线</view><view class="muted">{{map.notice}}</view></view>
    <scroll-view class="subfilters" scroll-x><view class="subfilter {{selectedRouteId === 'CUSTOM' ? 'active' : ''}}" bindtap="startCustomRoute">自选路线</view><view wx:for="{{routes}}" wx:key="id" class="subfilter {{selectedRouteId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectRoute">{{item.title || '寨中慢游'}}</view></scroll-view>
    <view wx:if="{{!routes.length}}" class="state">暂无公开示意路线，仍可查看地点。</view>
    <view class="map-canvas">
      <view wx:for="{{routeSegments}}" wx:key="id" class="map-line" style="{{item.style}}"></view>
      <block wx:for="{{map.places}}" wx:key="id"><view wx:if="{{item.drawable}}" class="map-pin {{item.customOrder ? 'selected' : ''}}" style="left:{{item.left}}%;top:{{item.top}}%;" data-id="{{item.id}}" bindtap="toggleCustomRoute"><text>{{item.customOrder || ''}}</text>{{item.name}}</view></block>
    </view>
    <view wx:if="{{routeSteps.length}}" class="route-steps"><view class="section-title">{{selectedRouteId === 'CUSTOM' ? '我的自选顺序' : '路线顺序'}}</view><view wx:for="{{routeSteps}}" wx:key="viewKey" class="route-step"><text>{{item.sequence}}</text><view><view>{{item.placeName}}</view><view class="muted">{{item.displayNote}}</view></view></view><button wx:if="{{selectedRouteId === 'CUSTOM'}}" class="ghost" bindtap="clearCustomRoute">清空自选路线</button></view>
    <view wx:if="{{routeMessage}}" class="count-note">{{routeMessage}}</view>
    <view class="place" wx:for="{{map.places}}" wx:key="id">
      <image wx:if="{{item.displayImageUrl}}" class="place-image" src="{{item.displayImageUrl}}" mode="aspectFill"/>
      <view class="card-title">{{item.name}}</view><view class="muted">{{item.category}} · {{item.description}}</view><view class="image-note" wx:if="{{item.imageNote}}">{{item.imageNote}}</view><text wx:if="{{!item.drawable}}">仅文字节点，未绘制位置</text><button class="ghost" data-id="{{item.id}}" bindtap="toggleCustomRoute">{{item.customOrder ? '路线第 ' + item.customOrder + ' 站' : '加入自选路线'}}</button><button class="ghost" data-kind="travel" data-id="{{item.id}}" bindtap="openDetail">查看地点</button>
    </view>
  </block>
</view>
