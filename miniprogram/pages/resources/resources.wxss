.filters,.subfilters{white-space:nowrap;margin:28rpx 0}.filter,.subfilter{display:inline-block;min-width:80rpx;padding:13rpx 22rpx;margin-right:12rpx;border:1rpx solid #d7d7cc;color:#315f4b;border-radius:999rpx;text-align:center}.filter.active,.subfilter.active{color:#fff;background:#315f4b}.subfilter{padding:10rpx 20rpx;font-size:22rpx}.state,.resource-card,.merchant,.menu,.place,.map-head,.route-steps,.count-note{margin-top:20rpx;padding:24rpx;background:#fffdf8;border:1rpx solid rgba(49,95,75,.12);border-radius:20rpx}.error{color:#933f31;background:#fff1ea}.search-box{margin-top:20rpx;padding:18rpx 24rpx;background:#fffdf8;border:1rpx solid #d7d7cc;border-radius:999rpx}.stay-people{display:flex;align-items:center;gap:14rpx;margin-top:16rpx;padding:18rpx 24rpx;color:#315f4b;background:#f4f7f1;border:1rpx solid rgba(49,95,75,.12);border-radius:18rpx;font-size:23rpx}.stay-people input{flex:1;min-width:0;padding:8rpx 12rpx;color:#294c50;background:#fffdf8;border:1rpx solid #d7d7cc;border-radius:12rpx;text-align:center}.card-image{display:block;width:100%;height:280rpx;margin-bottom:18rpx;border-radius:14rpx}.image-empty{display:flex;align-items:center;justify-content:center;color:#718077;background:#edf1e7}.image-note{margin:8rpx 0 14rpx;color:#8a654d;font-size:20rpx}.card-title{color:#173f36;font-size:29rpx;font-weight:700;margin:8rpx 0}.price{color:#b55e3e;font-size:31rpx;font-weight:700;margin-top:16rpx}.price text{display:block;color:#718077;font-size:19rpx;font-weight:400}.tag-row{display:flex;flex-wrap:wrap;gap:8rpx;margin:12rpx 0}.tag-row text{padding:6rpx 13rpx;color:#315f4b;background:#edf1e7;border-radius:999rpx;font-size:19rpx}.card-actions{display:grid;grid-template-columns:1fr 1.4fr;gap:12rpx;margin-top:20rpx}.ghost{color:#315f4b;background:transparent;border:1rpx solid #315f4b}.merchant{display:grid;grid-template-columns:120rpx 1fr;gap:18rpx;align-items:center}.merchant-image{width:120rpx;height:100rpx;border-radius:12rpx}.merchant.active{color:#fff;background:#315f4b}.merchant.active .card-title,.merchant.active .muted{color:#fff}.menu-row{display:grid;grid-template-columns:96rpx 1fr 105rpx;gap:16rpx;align-items:center;padding:22rpx 0;border-bottom:1rpx solid #ece6d9}.menu-image{width:96rpx;height:96rpx;border-radius:12rpx}.menu-row input{padding:15rpx;background:#fff;border:1rpx solid #d7d7cc;text-align:center}.room-summary,.count-note{color:#795236}.room-summary{margin-top:16rpx}.map-canvas{position:relative;height:560rpx;margin-top:20rpx;overflow:hidden;background:radial-gradient(circle at 30% 30%,rgba(198,115,77,.2),transparent 25%),radial-gradient(circle at 70% 65%,rgba(49,95,75,.22),transparent 28%),#edf1e7;border:1rpx solid rgba(49,95,75,.2);border-radius:45%}.map-line{position:absolute;z-index:1;height:5rpx;background:rgba(181,94,62,.65);transform-origin:left center}.map-pin{position:absolute;z-index:2;width:150rpx;transform:translate(-50%,-50%);color:#173f36;font-size:20rpx;font-weight:700;text-align:center}.map-pin text{display:block;width:22rpx;height:22rpx;margin:0 auto 5rpx;background:#c6734d;border:5rpx solid #fff7e9;border-radius:50%}.route-step{display:flex;gap:16rpx;align-items:center;margin-top:16rpx}.route-step>text{display:grid;flex:0 0 38rpx;height:38rpx;place-items:center;color:#fff;background:#c6734d;border-radius:50%}.place-image{width:180rpx;height:130rpx;float:right;margin-left:18rpx;border-radius:12rpx}.place>text{display:block;color:#b55e3e;font-size:20rpx}.place button{margin-top:18rpx}
.map-pin.selected text{width:30rpx;height:30rpx;background:#397f7a;box-shadow:0 0 0 7rpx rgba(57,127,122,.16)}
.food-hint{margin-top:14rpx;padding:14rpx 16rpx;color:#315f4b;background:#e7f2e7;border-radius:14rpx;font-size:22rpx;line-height:1.6}.menu-row.is-highlighted{margin:10rpx -12rpx;padding:22rpx 12rpx;border:2rpx solid #79a885;border-radius:16rpx;background:#f2faf0;box-shadow:0 8rpx 22rpx rgba(57,127,122,.1)}
.stay-hint{margin-top:14rpx;padding:14rpx 16rpx;color:#315f4b;background:#e7f2e7;border-radius:14rpx;font-size:22rpx;line-height:1.6}.resource-card.is-highlighted{border:2rpx solid #79a885;background:#f8fcf6;box-shadow:0 8rpx 22rpx rgba(57,127,122,.1)}
.food-start{margin-top:20rpx;padding:26rpx;background:linear-gradient(135deg,rgba(183,213,223,.58),rgba(250,247,239,.9) 52%,rgba(169,200,173,.4));border:1rpx solid rgba(57,127,122,.2);border-radius:24rpx 12rpx 24rpx 12rpx}.food-start .section-title{margin:8rpx 0 12rpx}.food-start-note{margin:14rpx 0;color:#795236;font-size:21rpx}.food-start-item{display:grid;grid-template-columns:84rpx 1fr auto;gap:16rpx;align-items:center;margin-top:14rpx;padding:10rpx;background:rgba(255,253,248,.84);border:1rpx solid rgba(57,127,122,.16);border-radius:14rpx}.food-start-item image{width:84rpx;height:84rpx;border-radius:10rpx}.food-start-item text{color:#397f7a;font-size:20rpx;white-space:nowrap}
