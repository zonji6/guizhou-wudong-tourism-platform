.filters{white-space:nowrap;margin:28rpx 0}.filter{display:inline-block;min-width:80rpx;padding:13rpx 22rpx;margin-right:12rpx;border:1rpx solid #d7d7cc;color:#315f4b;border-radius:999rpx;text-align:center}.filter.active{color:#fff;background:#315f4b}.state,.resource-card,.merchant,.menu,.place,.map-head{margin-top:20rpx;padding:24rpx;background:#fffdf8;border:1rpx solid rgba(49,95,75,.12);border-radius:20rpx}.error{color:#933f31;background:#fff1ea}.card-title{color:#173f36;font-size:29rpx;font-weight:700;margin:8rpx 0}.price{color:#b55e3e;font-size:31rpx;font-weight:700;margin-top:16rpx}.price text{display:block;color:#718077;font-size:19rpx;font-weight:400}.merchant.active{color:#fff;background:#315f4b}.merchant.active .card-title,.merchant.active .muted{color:#fff}.menu-row{display:grid;grid-template-columns:1fr 120rpx;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #ece6d9}.menu-row input{align-self:center;padding:15rpx;background:#fff;border:1rpx solid #d7d7cc;text-align:center}.room{display:flex;justify-content:space-between;align-items:center;width:100%;margin-top:16rpx;padding:20rpx;border:1rpx solid #d7d7cc;background:#f9f6ed;text-align:left}.room view{display:grid;gap:6rpx}.map-canvas{position:relative;height:560rpx;margin-top:20rpx;overflow:hidden;background:radial-gradient(circle at 30% 30%,rgba(198,115,77,.2),transparent 25%),radial-gradient(circle at 70% 65%,rgba(49,95,75,.22),transparent 28%),#edf1e7;border:1rpx solid rgba(49,95,75,.2);border-radius:45%}.map-pin{position:absolute;width:150rpx;transform:translate(-50%,-50%);color:#173f36;font-size:20rpx;font-weight:700;text-align:center}.map-pin text{display:block;width:22rpx;height:22rpx;margin:0 auto 5rpx;background:#c6734d;border:5rpx solid #fff7e9;border-radius:50%}.place>text{color:#b55e3e;font-size:20rpx}
