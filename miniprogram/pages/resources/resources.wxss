.filters{white-space:nowrap;margin:28rpx 0}.filter{display:inline-block;padding:12rpx 19rpx;margin-right:12rpx;border:1rpx solid #ddd8cc;color:#315f4b;border-radius:30rpx;font-size:24rpx}.filter.active{color:#fff;border-color:#315f4b;background:#315f4b}.service{display:flex;gap:20rpx;min-height:176rpx;padding:18rpx;margin-bottom:18rpx;background:#fffdf8;border-radius:8rpx}.service image,.image-fallback{width:200rpx;height:176rpx;flex:none}.image-fallback{display:flex;align-items:center;justify-content:center;padding:16rpx;box-sizing:border-box;background:#315f4b;color:#f5e7cf;text-align:center;font-size:22rpx;line-height:1.45}.service-body{flex:1}.service-title{font-size:28rpx;font-weight:600;line-height:1.4}.service-intro{color:#718077;font-size:22rpx;margin-top:10rpx;line-height:1.45}.service-price{color:#b56f3b;margin-top:16rpx}.service-price text{color:#718077;font-size:19rpx}
