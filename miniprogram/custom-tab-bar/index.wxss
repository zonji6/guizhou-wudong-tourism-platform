.custom-tab-bar{position:fixed;bottom:0;left:0;right:0;display:flex;align-items:end;padding:12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));background:#f2efe5;border-top:1rpx solid #dce2d9;z-index:99}.tab-item{flex:1;text-align:center;color:#718077;font-size:21rpx}.is-selected{color:#173f36;font-weight:700}.guide-leaf{margin-top:-38rpx}.leaf-mark{width:76rpx;height:76rpx;line-height:76rpx;margin:auto auto 4rpx;border-radius:50%;background:#d8cb86;color:#173f36;font-size:42rpx;box-shadow:0 4rpx 12rpx #173f3640}
