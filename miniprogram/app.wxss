page { background:#f7f3e9; color:#22322c; font-family:Arial, sans-serif; }
.page { padding:28rpx; }.eyebrow { color:#b56f3b; font-size:22rpx; letter-spacing:3rpx; }.title { font-size:42rpx; font-weight:700; margin:10rpx 0 20rpx; }.muted { color:#718077; font-size:25rpx; }.demo { color:#9a5f30; background:#fff1d7; font-size:20rpx; padding:4rpx 9rpx; border-radius:5rpx; }.primary { margin-top:20rpx; color:#fff; background:#315f4b; border-radius:6rpx; padding:20rpx; text-align:center; }.section-head { display:flex; justify-content:space-between; align-items:end; margin:36rpx 0 18rpx; }.section-title { font-size:32rpx; font-weight:700; }.card { background:#fffdf8; border-radius:7rpx; box-shadow:0 8rpx 20rpx rgba(35,58,46,.07); overflow:hidden; }.tag { color:#315f4b; background:#e9f0e7; padding:5rpx 10rpx; margin-right:8rpx; font-size:21rpx; }.input { background:#fff; border:1rpx solid #ded8cc; padding:18rpx; border-radius:5rpx; margin-top:12rpx; }
